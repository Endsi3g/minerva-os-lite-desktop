{
  "name": "minerva-os-lite-desktop",
  "version": "3.95.0",
  "type": "module",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "electron:build": "([ -d app/api ] && mv app/api app-api-temp || true); cross-env EXPORT_MODE=true next build; status=$?; ([ -d app-api-temp ] && mv app-api-temp app/api || true); [ $status -eq 0 ] && electron-builder && bash scripts/sign-app.sh \"dist/mac-arm64/Minerva OS Reach Lite.app\"",
    "cap:sync": "([ -d app/api ] && mv app/api app-api-temp || true); cross-env EXPORT_MODE=true next build; status=$?; ([ -d app-api-temp ] && mv app-api-temp app/api || true); [ $status -eq 0 ] && cap sync",
    "cap:open:ios": "cap open ios",
    "cap:sync:android": "([ -d app/api ] && mv app/api app-api-temp || true); cross-env EXPORT_MODE=true next build; status=$?; ([ -d app-api-temp ] && mv app-api-temp app/api || true); [ $status -eq 0 ] && cap sync android",
    "cap:sync:ios": "([ -d app/api ] && mv app/api app-api-temp || true); cross-env EXPORT_MODE=true next build; status=$?; ([ -d app-api-temp ] && mv app-api-temp app/api || true); [ $status -eq 0 ] && cap sync ios",
    "cap:open:android": "cap open android",
    "pre-migration": "node scripts/pre-migration-check.js",
    "launch": "node scripts/launcher.js",
    "deploy": "node scripts/deploy.js",
    "postinstall": "node scripts/setup-git-hooks.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@capacitor/android": "^8.4.0",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@mendable/firecrawl-js": "^4.28.0",
    "@radix-ui/react-popover": "^1.1.16",
    "@radix-ui/react-switch": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.14",
    "@radix-ui/react-use-controllable-state": "^1.2.3",
    "@sentry/nextjs": "^10.63.0",
    "@shadcn/react": "^0.2.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "@tanstack/react-table": "^8.21.3",
    "@thesvg/react": "^3.0.17",
    "@tiptap/extension-character-count": "^3.26.1",
    "@tiptap/extension-image": "^3.26.1",
    "@tiptap/extension-link": "^3.26.1",
    "@tiptap/extension-placeholder": "^3.26.1",
    "@tiptap/extension-text-align": "^3.26.1",
    "@tiptap/extension-underline": "^3.26.1",
    "@tiptap/pm": "^3.26.1",
    "@tiptap/react": "^3.26.1",
    "@tiptap/starter-kit": "^3.26.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^6.0.208",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "electron-updater": "^6.8.9",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.17.0",
    "maplibre-gl": "^5.24.0",
    "motion": "^12.40.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.0",
    "radix-ui": "^1.5.0",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "recharts": "^3.8.0",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "sqlite3": "^6.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.0",
    "@capacitor/ios": "^8.4.0",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "electron": "43.0.0-beta.3",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.minerva.reachlite",
    "productName": "Minerva OS Reach Lite",
    "icon": "public/icon-512.png",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "electron/**/*",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "Endsi3g",
      "repo": "minerva-os-lite-desktop"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon-512.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icon-512.png",
      "hardenedRuntime": true,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist"
    }
  }
}
