# Temp folder created by electron:build / cap:sync (api routes moved here during static export)
app-api-temp/

# Electron build output
dist/

# Capacitor mobile builds
ios/
android/

# Next.js build cache (Vercel rebuilds from source)
.next/
out/

# Node modules
node_modules/

# Debug logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Environment files — prevent local env files from overriding Vercel dashboard environment variables
.env*
!.env.example
