# Supabase Credentials (Required for authentication and remote database access)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=votre-cle-anon

# Supabase Admin Secret Key (Server-side API routes only - DO NOT expose to client)
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role

# Google APIs (OAuth Gmail / Drive)
GOOGLE_CLIENT_ID=votre-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=votre-client-secret

# Artificial Intelligence API Keys (Anthropic / OpenRouter)
ANTHROPIC_API_KEY=votre-cle-anthropic

# Email Notifications (Resend — https://resend.com)
# Used by lib/email-service.ts for transactional emails (weekly digest, lead alerts, mentions, etc.)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Native mobile push notifications (FCM HTTP v1 — Capacitor iOS/Android)
# Used by lib/push-service.ts. Create a Firebase project, add the iOS/Android apps
# (bundle id com.minerva.reachlite from capacitor.config.json), then Project Settings →
# Service Accounts → Generate new private key. Paste the full JSON as a single line here.
# Without this set, sendPushToUser() no-ops (logs only) — DB-backed in-app notifications
# still work, only the native phone push is skipped.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Google Places API (New) — https://developers.google.com/maps/documentation/places/web-service
# Used by app/api/leads/enrich-google/route.ts (rating, reviews, photos, opening hours) and
# the "Avis" tab on the lead detail page. Enable "Places API (New)" in Google Cloud Console
# and restrict the key to that API. This is only a global fallback — each user can (and, in a
# multi-tenant deployment, should) set their own key in Paramètres > Intégrations, which takes
# priority (settings.google_places_api_key). Without either configured, enrichment returns a
# clear "configuration requise" error instead of failing silently.
GOOGLE_PLACES_API_KEY=

# Hermes service-to-service auth (REQUIRED for app/api/agent/* tool endpoints — campaigns/summary,
# field/briefing, inbox/suggest-reply, leads/search, playbooks/deploy, sequences/create, tasks/create)
# Generate a long random secret (e.g. `openssl rand -hex 32`) — no default fallback exists in code.
HERMES_SERVICE_TOKEN=

# Cloudflare Workers AI (optional — Kimi K2 fallback provider in lib/ai.ts, used only if
# ANTHROPIC_API_KEY and OPENROUTER_API_KEY are both absent/unavailable)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Sentry error monitoring
# DSN is available in your Sentry project → Settings → Client Keys
# instrumentaion-client.ts and instrumentation.ts will no-op safely if unset.
NEXT_PUBLIC_SENTRY_DSN=https://xxxx@o0.ingest.us.sentry.io/0
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=your-sentry-project-slug
# Generate at https://sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN=sntrys_xxxx
