# Supabase Credentials (Required for authentication and remote database access)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=votre-cle-anon

# Supabase Admin Secret Key (Server-side API routes only - DO NOT expose to client)
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role

# Google APIs (OAuth Gmail / Drive)
GOOGLE_CLIENT_ID=votre-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=votre-client-secret

# Artificial Intelligence API Keys (Anthropic / OpenRouter)
ANTHROPIC_API_KEY=votre-cle-anthropic

# Email Notifications (Resend — https://resend.com)
# Used by lib/email-service.ts for transactional emails (weekly digest, lead alerts, mentions, etc.)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
